<div
  phx-hook="FileDownload"
  id="file-download-hook"
  class="absolute w-0 h-0 overflow-hidden pointer-events-none"
  aria-hidden="true"
  style="position: absolute; width: 0; height: 0; margin: 0; padding: 0; border: 0;"
>
</div>
<div class="min-h-screen bg-gray-50 p-4 sm:p-6 lg:p-8">
  <!-- Header Section with Download Button -->
  <div class="-my-20 mb-6">
    <.link
      navigate={~p"/"}
      class="inline-flex items-center text-sm text-blue-600 hover:text-blue-800 mb-4"
    >
      <.icon name="hero-arrow-left" class="h-4 w-4 mr-1" /> Back to Dashboard
    </.link>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">
          <%= @system_name %>
        </h1>
        <p class="text-sm text-gray-600 mt-1">
          Last updated:
          <%= if @timestamp do %>
            <%= time_ago(@timestamp) %>
          <% else %>
            Never
          <% end %>
        </p>
        <p class="text-xs text-gray-500 mt-1">
          Showing last <%= length(@history) %> health checks
        </p>
      </div>
      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
        <button
          phx-click="download_history"
          class="inline-flex items-center justify-center px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 active:bg-green-800 transition-colors"
        >
          <.icon name="hero-arrow-down-tray" class="h-5 w-5 mr-2" /> Download History
        </button>

        <button
          phx-click="refresh"
          class="inline-flex items-center justify-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 active:bg-blue-800 transition-colors"
        >
          <.icon name="hero-arrow-path" class="h-5 w-5 mr-2" /> Refresh Now
        </button>
      </div>
    </div>
  </div>
  <!-- No Data State -->
  <%= if @history == [] do %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6 text-center">
      <.icon name="hero-exclamation-triangle" class="h-12 w-12 text-yellow-600 mx-auto mb-3" />
      <p class="text-yellow-800 font-medium">No data available for this system</p>
      <p class="text-yellow-600 text-sm mt-2">
        Health checks will appear here once executed.
      </p>
    </div>
  <% else %>
    <!-- History Timeline: Grouped by Check Time -->
    <div class="space-y-4">
      <%= for check <- @history do %>
        <% timestamp_str = DateTime.to_iso8601(check.timestamp)
        is_expanded = is_check_expanded?(@expanded_checks, check.timestamp)
        is_first = check == List.first(@history) %>

        <div class="bg-white rounded-lg shadow-md overflow-hidden">
          <!-- Collapsible Header -->
          <button
            phx-click="toggle_check"
            phx-value-timestamp={timestamp_str}
            class="w-full px-6 py-4 flex items-center justify-between hover:bg-gray-50 transition-colors"
          >
            <div class="flex items-center gap-4">
              <!-- Expand/Collapse Icon -->
              <div class="text-gray-400">
                <%= if is_expanded do %>
                  <.icon name="hero-chevron-down" class="h-5 w-5" />
                <% else %>
                  <.icon name="hero-chevron-right" class="h-5 w-5" />
                <% end %>
              </div>
              <!-- Timestamp -->
              <div class="text-left">
                <div class="flex items-center gap-2">
                  <.icon name="hero-clock" class="h-5 w-5 text-gray-500" />
                  <span class="font-semibold text-gray-900">
                    <%= format_timestamp(check.timestamp) %>
                  </span>
                  <%= if is_first do %>
                    <span class="text-xs px-2 py-1 bg-green-100 text-green-800 rounded-full font-medium">
                      Latest
                    </span>
                  <% end %>
                </div>
                <p class="text-sm text-gray-500 mt-1">
                  <%= time_ago(check.timestamp) %> · <%= map_size(check.results) %> commands executed
                </p>
              </div>
            </div>
            <!-- Summary Stats -->
            <div class="flex gap-2">
              <span class="text-xs px-2 py-1 bg-gray-100 text-gray-700 rounded">
                <%= map_size(check.results) %> checks
              </span>
            </div>
          </button>
          <!-- Expanded Content: Command Results -->
          <%= if is_expanded do %>
            <div class="border-t border-gray-200">
              <div class="p-6">
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                  <%= for {_cmd_id, result} <- check.results do %>
                    <div class="bg-gray-50 rounded-lg border border-gray-200">
                      <!-- Card Header -->
                      <div class="p-4 border-b border-gray-200 bg-white">
                        <div class="flex items-start justify-between gap-3">
                          <div class="flex-1 min-w-0">
                            <h3 class="text-sm font-semibold text-gray-900 truncate">
                              <%= result.description %>
                            </h3>
                            <p class="text-xs text-gray-500 mt-1 break-all font-mono">
                              <%= result.command %>
                            </p>
                          </div>
                          <div class="flex-shrink-0">
                            <%= render_status_badge(result) %>
                          </div>
                        </div>
                      </div>
                      <!-- Card Body -->
                      <div class="p-4">
                        <%= render_result_content(result) %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
