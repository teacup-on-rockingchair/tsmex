<div class="p-4 sm:p-8">
  <!-- Header -->
  <div class="mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-800">System Monitor Dashboard</h1>
        <p class="text-xs sm:text-sm text-gray-600 mt-2">
          Showing last known state for each metric. Data may be from previous checks if recent checks failed.
        </p>
      </div>
      <!-- Legend for Desktop -->
      <div class="hidden lg:flex items-center gap-4 text-sm">
        <div class="flex items-center gap-2">
          <div class="w-4 h-4 bg-green-100 border border-green-300 rounded"></div>
          <span>Healthy</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-4 h-4 bg-yellow-100 border border-yellow-300 rounded"></div>
          <span>Warning</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-4 h-4 bg-red-100 border border-red-300 rounded"></div>
          <span>Critical</span>
        </div>
      </div>
    </div>
    <!-- Legend for Mobile/Tablet -->
    <div class="lg:hidden flex flex-wrap gap-3 text-xs mt-4">
      <div class="flex items-center gap-1.5">
        <div class="w-3 h-3 bg-green-100 border border-green-300 rounded"></div>
        <span>Healthy</span>
      </div>
      <div class="flex items-center gap-1.5">
        <div class="w-3 h-3 bg-yellow-100 border border-yellow-300 rounded"></div>
        <span>Warning</span>
      </div>
      <div class="flex items-center gap-1.5">
        <div class="w-3 h-3 bg-red-100 border border-red-300 rounded"></div>
        <span>Critical</span>
      </div>
    </div>
  </div>

  <%= if Enum.empty?(@systems) do %>
    <!-- Empty State -->
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6 text-center">
      <p class="text-yellow-800 font-medium">No systems data available yet</p>
      <p class="text-yellow-600 text-sm mt-2">
        Health checks will appear here once executed. Checks run every 10-1800 seconds.
      </p>
      <%= if Enum.empty?(@commands) do %>
        <p class="text-red-600 text-sm mt-4">
          ⚠ Commands configuration not loaded. Check your COMMANDS_CONFIG_PATH.
        </p>
      <% end %>
    </div>
  <% else %>
    <!-- Desktop View: Table (hidden on mobile/tablet) -->
    <div class="hidden lg:block overflow-x-auto shadow-md rounded-lg">
      <table class="min-w-full bg-white border border-gray-200">
        <thead class="bg-gray-100">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase border-b">
              System
            </th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase border-b">
              Status
            </th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase border-b">
              Last Check
            </th>
            <%= for cmd <- @commands do %>
              <th
                class="px-4 py-3 text-center text-xs font-medium text-gray-700 uppercase border-b"
                title={cmd.command}
              >
                <%= cmd.description %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <%= for system <- @systems do %>
            <tr class={"transition-colors #{SystemHealth.health_color_class(SystemHealth.health_status(system))}"}>
              <td class="px-4 py-3 border-b">
                <.link
                  navigate={~p"/systems/#{system.system_name}"}
                  class="text-blue-600 hover:text-blue-800 hover:underline font-medium"
                >
                  <%= system.system_name %>
                </.link>
              </td>
              <td class="px-4 py-3 border-b">
                <span class={"px-2 inline-flex text-xs leading-5 font-semibold rounded-full #{status_badge_class(SystemHealth.health_status(system))}"}>
                  <%= status_text(SystemHealth.health_status(system)) %>
                </span>
              </td>
              <td class="px-4 py-3 text-sm text-gray-600 border-b">
                <div class="flex flex-col">
                  <span class="font-medium"><%= time_ago(system.last_check_time) %></span>
                  <span class="text-xs text-gray-400">
                    <%= format_timestamp(system.last_check_time) %>
                  </span>
                </div>
              </td>
              <%= for cmd <- @commands do %>
                <td class="px-4 py-3 text-center border-b">
                  <.command_cell system={system} command={cmd} />
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <!-- Mobile/Tablet View: Collapsible Cards (hidden on desktop) -->
    <div class="lg:hidden space-y-3">
      <%= for system <- @systems do %>
        <% health = SystemHealth.health_status(system) %>
        <div class={"rounded-lg shadow overflow-hidden transition-all #{SystemHealth.health_color_class(health)}"}>
          <!-- Card Header (Always Visible) -->
          <button
            phx-click="toggle_system"
            phx-value-system={system.system_name}
            class="w-full px-4 py-4 flex items-center justify-between hover:opacity-90 transition-opacity"
            type="button"
          >
            <div class="flex items-center gap-3 flex-1 min-w-0">
              <!-- Status Dot -->
              <div class={"flex-shrink-0 w-3 h-3 rounded-full #{status_dot_class(health)}"}></div>
              <!-- System Info -->
              <div class="flex-1 min-w-0 text-left">
                <div class="text-base font-semibold text-gray-900 truncate">
                  <%= system.system_name %>
                </div>
                <div class="text-xs text-gray-600 flex items-center gap-2 mt-0.5">
                  <span class="truncate"><%= time_ago(system.last_check_time) %></span>
                  <span>•</span>
                  <span class={"font-medium #{status_badge_text_color(health)}"}>
                    <%= status_text(health) %>
                  </span>
                </div>
              </div>
            </div>
            <!-- Expand/Collapse Icon -->
            <div class="flex-shrink-0 ml-3">
              <%= if is_expanded?(@expanded_systems, system.system_name) do %>
                <!-- Chevron Up -->
                <svg
                  class="w-5 h-5 text-gray-500"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 15l7-7 7 7"
                  />
                </svg>
              <% else %>
                <!-- Chevron Down -->
                <svg
                  class="w-5 h-5 text-gray-500"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              <% end %>
            </div>
          </button>
          <!-- Expanded Content (Collapsible) -->
          <%= if is_expanded?(@expanded_systems, system.system_name) do %>
            <div class="border-t border-gray-200 bg-white">
              <!-- System Details -->
              <div class="px-4 py-3 bg-gray-50 border-b border-gray-200">
                <div class="text-xs text-gray-500 space-y-1">
                  <div class="flex justify-between">
                    <span class="font-medium">Last Check:</span>
                    <span><%= format_timestamp(system.last_check_time) %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="font-medium">Status:</span>
                    <span class={"font-semibold #{status_badge_text_color(health)}"}>
                      <%= status_text(health) %>
                    </span>
                  </div>
                </div>
              </div>
              <!-- Command Results -->
              <div class="px-4 py-3 space-y-3">
                <%= if @commands != [] do %>
                  <%= for cmd <- @commands do %>
                    <div class="bg-gray-50 rounded-lg p-3">
                      <div class="flex items-start justify-between gap-2 mb-2">
                        <div class="text-xs font-medium text-gray-500 uppercase">
                          <%= cmd.description %>
                        </div>
                      </div>

                      <div class="mt-2">
                        <.command_cell_mobile system={system} command={cmd} />
                      </div>
                    </div>
                  <% end %>
                <% else %>
                  <p class="text-sm text-gray-500 text-center py-4">No commands configured</p>
                <% end %>
              </div>
              <!-- View Details Link -->
              <div class="px-4 py-3 bg-gray-50 border-t border-gray-200">
                <.link
                  navigate={~p"/systems/#{system.system_name}"}
                  class="block text-center text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors"
                >
                  View Full Details →
                </.link>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <!-- Footer Tip -->
    <div class="mt-4 text-xs text-gray-500">
      <p class="hidden lg:block">
        💡 Tip: Click on a system name to see detailed history and timestamps for each metric.
      </p>
      <p class="lg:hidden">
        💡 Tip: Tap a system to expand details, or tap the name to see full history.
      </p>
    </div>
  <% end %>
</div>
